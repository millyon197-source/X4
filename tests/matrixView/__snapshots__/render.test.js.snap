exports[`build-needs budget panel > renders with an empty state object 1`] = `""`;

exports[`construction budget panel > renders expanded with no blueprint 1`] = `
"
      <div class="bp-level-panel construction-budget-panel bi-panel " data-bi-panel="construction-budget" style="border-color: rgba(56, 189, 248, 0.35); flex-shrink: 0; width: 100%; box-sizing: border-box; margin-top: 0.65rem; margin-bottom: 0;">
        <div class="bp-level-header bp-cb-header" style="background: rgba(15, 23, 42, 0.85); padding: 0.5rem 0.65rem; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:0.4rem; cursor:pointer;" title="Click to collapse Plan Construction Budget">
          <div class="bp-level-title-group" style="display:flex; align-items:center; gap:6px;">
            <span class="bp-level-arrow bp-cb-arrow">▼</span>
            <span style="font-size:0.9rem;">💰</span>
            <strong style="color:#38bdf8; font-size:0.8rem; font-family:var(--font-heading); text-transform:uppercase; letter-spacing:0.03em;">Plan Construction Budget</strong>
          </div>
          <div class="price-mode-toggles" style="display:flex; align-items:center; gap:0.2rem;">
            <button type="button" class="btn-price-tier " data-price-tier="min" style="padding:0.15rem 0.4rem; font-size:0.68rem; border-radius:3px; border:1px solid rgba(255,255,255,0.1); background:rgba(255,255,255,0.03); color:#cbd5e1; cursor:pointer; font-weight:700;">Min</button>
            <button type="button" class="btn-price-tier active" data-price-tier="avg" style="padding:0.15rem 0.4rem; font-size:0.68rem; border-radius:3px; border:1px solid #38bdf8; background:rgba(56, 189, 248, 0.25); color:#38bdf8; cursor:pointer; font-weight:700;">Avg</button>
            <button type="button" class="btn-price-tier " data-price-tier="max" style="padding:0.15rem 0.4rem; font-size:0.68rem; border-radius:3px; border:1px solid rgba(255,255,255,0.1); background:rgba(255,255,255,0.03); color:#cbd5e1; cursor:pointer; font-weight:700;">Max</button>
          </div>
        </div>
        <div class="bp-cb-body" style="padding: 0.5rem 0.75rem; background: rgba(30, 41, 59, 0.4); display:block;">
          <p style="color:#94a3b8; font-style:italic; margin:0; font-size:0.75rem;">No construction resources required.</p>
        </div>
      </div>
    "
`;

exports[`construction budget panel > renders with an empty state object 1`] = `
"
      <div class="bp-level-panel construction-budget-panel bi-panel " data-bi-panel="construction-budget" style="border-color: rgba(56, 189, 248, 0.35); flex-shrink: 0; width: 100%; box-sizing: border-box; margin-top: 0.65rem; margin-bottom: 0;">
        <div class="bp-level-header bp-cb-header" style="background: rgba(15, 23, 42, 0.85); padding: 0.5rem 0.65rem; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:0.4rem; cursor:pointer;" title="Click to expand Plan Construction Budget">
          <div class="bp-level-title-group" style="display:flex; align-items:center; gap:6px;">
            <span class="bp-level-arrow bp-cb-arrow">▶</span>
            <span style="font-size:0.9rem;">💰</span>
            <strong style="color:#38bdf8; font-size:0.8rem; font-family:var(--font-heading); text-transform:uppercase; letter-spacing:0.03em;">Plan Construction Budget</strong>
          </div>
          <div class="price-mode-toggles" style="display:flex; align-items:center; gap:0.2rem;">
            <button type="button" class="btn-price-tier " data-price-tier="min" style="padding:0.15rem 0.4rem; font-size:0.68rem; border-radius:3px; border:1px solid rgba(255,255,255,0.1); background:rgba(255,255,255,0.03); color:#cbd5e1; cursor:pointer; font-weight:700;">Min</button>
            <button type="button" class="btn-price-tier active" data-price-tier="avg" style="padding:0.15rem 0.4rem; font-size:0.68rem; border-radius:3px; border:1px solid #38bdf8; background:rgba(56, 189, 248, 0.25); color:#38bdf8; cursor:pointer; font-weight:700;">Avg</button>
            <button type="button" class="btn-price-tier " data-price-tier="max" style="padding:0.15rem 0.4rem; font-size:0.68rem; border-radius:3px; border:1px solid rgba(255,255,255,0.1); background:rgba(255,255,255,0.03); color:#cbd5e1; cursor:pointer; font-weight:700;">Max</button>
          </div>
        </div>
        <div class="bp-cb-body" style="padding: 0.5rem 0.75rem; background: rgba(30, 41, 59, 0.4); display:none;">
          <p style="color:#94a3b8; font-style:italic; margin:0; font-size:0.75rem;">No construction resources required.</p>
        </div>
      </div>
    "
`;

