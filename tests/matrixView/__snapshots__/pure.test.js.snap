exports[`SCRAP_WARE_IDS > keeps its current members 1`] = `
[
  "RawScrap",
  "ScrapClaytronics",
  "ScrapHullParts",
  "ScrapMetal",
  "ScrapProc",
  "TerCompSubstrate",
  "TerScrapMetal",
  "TerSilCarbide",
]
`;

exports[`formatWareName > formats EC 1`] = `"Energy Cells"`;

exports[`formatWareName > formats SiliconCarbide 1`] = `"Silicon Carbide"`;

exports[`formatWareName > formats Water 1`] = `"Water"`;

exports[`formatWareName > formats hullparts 1`] = `"Hull Parts"`;

exports[`formatWareName > formats somethingElse 1`] = `"SomethingElse"`;

